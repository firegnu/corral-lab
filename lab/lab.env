# 真 agent 的启动命令（便宜模型）。格式：KEY=命令行，按 shell 规则拆词，不会被 shell 执行。
# lab 脚本读这个文件；同名环境变量优先（自检时用它换成假 agent）。
LAB_CLAUDE=claude --model haiku --add-dir /tmp/clab
LAB_CLAUDE_ASK=claude --model haiku --add-dir /tmp/clab --permission-mode default
LAB_CLAUDE_DEV=claude --model sonnet --add-dir /tmp/clab --allowedTools 'Bash(corral:*)' 'Bash(lab/bin/handoff:*)'
LAB_CODEX=codex --yolo -m gpt-5.6-luna -c 'model_reasoning_effort="low"'

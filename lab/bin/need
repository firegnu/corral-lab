#!/usr/bin/env python3
"""准备步骤用：检查需要的 agent 在不在（可要求状态）。

用法：lab/bin/need <名字>[=状态] …     例：lab/bin/need lab-a/dev=idle lab-a/review
      lab/bin/need --absent <名字> …    要求这些名字不在
退出码：0 都满足；1 有不满足的
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import lablib as L  # noqa: E402


def main():
    args = sys.argv[1:]
    absent = bool(args) and args[0] == "--absent"
    if absent:
        args = args[1:]
    if not args:
        sys.exit(__doc__)
    bad = 0
    for spec in args:
        name, _, want = spec.partition("=")
        code, st = L.corral("status", name)
        if absent:
            good = code == 2
            print(f"  {'OK ' if good else '不满足'}  {name} {'不在' if code == 2 else '还在（' + str(st.get('state')) + '）'}")
        elif code != 0:
            good = False
            print(f"  不满足  {name} 不在（退出码 {code}）")
        else:
            good = not want or st["state"] == want
            print(f"  {'OK ' if good else '不满足'}  {name} 状态 {st['state']}"
                  + (f"（要求 {want}）" if want else "") + f"  实例 {st['instance']}")
        bad += not good
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())

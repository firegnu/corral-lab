#!/usr/bin/env python3
"""列出 corral-lab 之外、和 lab 目录有关的痕迹。默认只列出；加 --purge-transcripts 才删除对话记录文件。
共享的配置和历史文件（Codex config.toml、~/.claude.json、两家的 history.jsonl）从不修改，只提示。

lab 目录：corral-lab 仓库、$LAB_TMP 以及它的真实路径（macOS 上 /tmp 是 /private/tmp）。
"""
import argparse
import json
import os
import re
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import lablib as L  # noqa: E402

HOME = os.path.expanduser("~")


def claude_dir_names():
    return [re.sub(r"[^A-Za-z0-9]", "-", r) for r in L.lab_roots()]


def codex_trust():
    path = os.path.join(HOME, ".codex", "config.toml")
    hits = []
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return path, hits
    for i, line in enumerate(lines):
        m = re.match(r'^\[projects\.["\'](.*)["\']\]\s*$', line)
        if m and L.under_roots(m.group(1)):
            hits.append((i + 1, line))
    return path, hits


def claude_trust():
    path = os.path.join(HOME, ".claude.json")
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return path, []
    return path, sorted(k for k in (data.get("projects") or {}) if L.under_roots(k))


def claude_transcripts():
    base = os.path.join(HOME, ".claude", "projects")
    if not os.path.isdir(base):
        return []
    prefixes = claude_dir_names()
    return sorted(os.path.join(base, d) for d in os.listdir(base)
                  if any(d == p or d.startswith(p + "-") for p in prefixes))


def codex_sessions():
    hits = []
    for sub in ("sessions", "archived_sessions"):
        base = os.path.join(HOME, ".codex", sub)
        for root, _, files in os.walk(base):
            for name in files:
                if not name.endswith(".jsonl"):
                    continue
                path = os.path.join(root, name)
                try:
                    with open(path, encoding="utf-8", errors="replace") as f:
                        first = json.loads(f.readline() or "null")
                except (OSError, ValueError):
                    continue
                payload = first.get("payload") if isinstance(first, dict) else None
                if isinstance(payload, dict) and L.under_roots(payload.get("cwd")):
                    hits.append((path, payload.get("id")))
    return sorted(hits)


def claude_history_count():
    n = 0
    for rec in L.read_jsonl(os.path.join(HOME, ".claude", "history.jsonl")):
        if isinstance(rec, dict) and L.under_roots(rec.get("project")):
            n += 1
    return n


def codex_history_count(session_ids):
    ids = {s for s in session_ids if s}
    return sum(1 for rec in L.read_jsonl(os.path.join(HOME, ".codex", "history.jsonl"))
               if isinstance(rec, dict) and rec.get("session_id") in ids)


def main():
    ap = argparse.ArgumentParser(prog="traces")
    ap.add_argument("--purge-transcripts", action="store_true")
    args = ap.parse_args()
    print("lab 目录：" + "  ".join(L.lab_roots()))

    path, hits = codex_trust()
    print(f"\n[Codex 信任记录] {path}（不自动改，请手动删掉这些段，每段是这一行和下面的 trust_level 行）")
    for lineno, line in hits:
        print(f"  第 {lineno} 行：{line}")
    if not hits:
        print("  没有")

    path, keys = claude_trust()
    print(f"\n[Claude Code 项目记录（含信任）] {path}（不自动改；要删请在没有 Claude Code 运行时删 projects 下这些键）")
    for k in keys:
        print(f"  {k}")
    if not keys:
        print("  没有")

    dirs = claude_transcripts()
    sessions = codex_sessions()
    print("\n[Claude Code 对话记录目录]" + ("（将删除）" if args.purge_transcripts else "（加 --purge-transcripts 删除）"))
    for d in dirs:
        print(f"  {d}")
    if not dirs:
        print("  没有")
    print("\n[Codex 会话文件]" + ("（将删除）" if args.purge_transcripts else "（加 --purge-transcripts 删除）"))
    for p, _ in sessions:
        print(f"  {p}")
    if not sessions:
        print("  没有")

    print(f"\n[历史记录，不修改] ~/.claude/history.jsonl 里 {claude_history_count()} 条、"
          f"~/.codex/history.jsonl 里 {codex_history_count([s for _, s in sessions])} 条和 lab 目录有关")

    if args.purge_transcripts:
        for d in dirs:
            shutil.rmtree(d, ignore_errors=True)
        for p, _ in sessions:
            try:
                os.remove(p)
            except OSError:
                pass
        print(f"\n已删除 {len(dirs)} 个对话记录目录、{len(sessions)} 个 Codex 会话文件")
    return 0


if __name__ == "__main__":
    sys.exit(main())

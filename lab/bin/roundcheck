#!/usr/bin/env python3
"""检查某个前缀最近一轮交接：列出 watch.log 时间线，核对判定和 findings.md 的实际情况一致、叫醒对了人。

用法：lab/bin/roundcheck <前缀> [--expect 判定] [--contains 文字]… [--not-contains 文字]… [--wait 秒]
  --expect：delivered / undelivered / interrupted / b_gone
  --wait：watcher 还在跑时最多等这么久
退出码：0 通过；1 不通过
"""
import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import lablib as L  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="roundcheck")
    ap.add_argument("prefix")
    ap.add_argument("--expect")
    ap.add_argument("--contains", action="append", default=[])
    ap.add_argument("--not-contains", action="append", default=[])
    ap.add_argument("--wait", type=float, default=0.0)
    args = ap.parse_args()

    run = L.run_dir(args.prefix)
    state_path = os.path.join(run, "state.json")
    deadline = time.time() + args.wait
    state = L.load_json(state_path)
    while L.pid_alive(state.get("watcher_pid"), "watch-deliver") and time.time() < deadline:
        time.sleep(1)
        state = L.load_json(state_path)
    rnd = state.get("round")
    checks = L.Checks(f"{args.prefix} 第 {rnd} 轮交接")
    if not checks.ok("有交接记录", rnd):
        return checks.done()
    checks.ok("watcher 已结束", not L.pid_alive(state.get("watcher_pid"), "watch-deliver"))

    events = [e for e in L.read_jsonl(os.path.join(run, "watch.log")) if e.get("round") == rnd]
    print("  时间线：")
    for e in events:
        detail = {k: v for k, v in e.items() if k not in ("t", "event", "prefix", "round") and v is not None}
        print(f"    {L.clock(e['t'])}  {e['event']}  {detail}")
    verdicts = [e for e in events if e["event"] in L.VERDICTS]
    verdict = verdicts[-1]["event"] if verdicts else None
    wakes = [e for e in events if e["event"].startswith("wake_a_")]
    checks.note("送出的话", f"{len(state.get('text', '').encode())} 字节：{state.get('text')}")

    if not checks.ok("有判定", verdict, str(verdict)):
        return checks.done()
    findings = os.path.join(run, "findings.md")
    ok, reason = L.findings_state(findings, state["sent_at"])
    if verdict in ("delivered", "undelivered"):
        checks.ok("判定和 findings.md 实际情况一致", (verdict == "delivered") == ok, reason)
        last = wakes[-1] if wakes else {}
        checks.ok(f"叫醒了 A（{state.get('a')}）", last.get("event") == "wake_a_delivered" and last.get("name") == state.get("a"),
                  last.get("event", "没有叫醒记录"))
    else:
        checks.ok("没有叫醒 A", not wakes)
    if args.expect:
        checks.ok(f"判定是 {args.expect}", verdict == args.expect, str(verdict))
    content = open(findings, encoding="utf-8", errors="replace").read() if os.path.exists(findings) else ""
    for text in args.contains:
        checks.ok(f"findings.md 含 {text}", text in content)
    for text in args.not_contains:
        checks.ok(f"findings.md 不含 {text}", text not in content)
    return checks.done()


if __name__ == "__main__":
    sys.exit(main())
